{
  "name": "landing-keepsake-vite",
  "private": true,
  "version": "1.0.0",
  "description": "Keepsake responsive landing page built with Vite, Pug, Modular SCSS, PostCSS, Sharp image pipeline, Prettier and Stylelint.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.0",
    "@vituum/vite-plugin-pug": "^1.0.2",
    "autoprefixer": "^10.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "sass": "^1.86.0",
    "sharp": "^0.33.5",
    "stylelint": "^16.15.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "^6.2.2",
    "vituum": "^1.1.3"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  }
}

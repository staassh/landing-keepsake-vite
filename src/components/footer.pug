footer#contact.footer
  .container.footer__top
    form.newsletter(action='#contact' method='get')
      h2.newsletter__title Newsletter
      p.newsletter__desc Fresh case studies and design notes, once a month.
      .newsletter__row
        label.sr-only(for='email') Your email address
        input#email.newsletter__input(
          type='email'
          placeholder='Your email address'
          required
          aria-describedby='email-error'
        )
        button.newsletter__btn(type='submit') Subscribe
      p#email-error.newsletter__error Please enter a valid email address.
      label.newsletter__consent
        input#consent.newsletter__checkbox(type='checkbox' required)
        span I agree to the privacy policy
      .newsletter__success(role='status')
        span.newsletter__check ✓
        span You're in! Check your inbox to confirm.
      p.newsletter__note One email a month. No spam, unsubscribe anytime.
    .footer-links
      each col in footerColumns
        .footer-links__col
          h3.footer-links__title= col.title
          each link in col.links
            a.footer-links__item(href=link.href)= link.label
  .container.footer__bottom
    p.footer__copy= siteMeta.copyright
    .social-list
      each soc in socialLinks
        a.social-list__link(
          class=`social-list__link--${soc.name}`
          href=soc.href
          aria-label=soc.label
        )= soc.text
a.backtop(href='#top' aria-label='Back to top')
  +icon('arrow-up', 18)

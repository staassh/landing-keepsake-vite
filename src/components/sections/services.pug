section#services.section.container
  +section-title(
    'What do we do',
    'We are a small team of designers and makers who help brands look their best online and offline.'
  )
  .services
    each service in servicesList
      article.service-card
        span.service-card__icon
          +icon(service.icon, 44)
        h3.service-card__title= service.title
        p.service-card__desc= service.description

section#works.section.works.container
  +section-title("Our awesome works")
  each cat in filterCategories
    input.works__radio(type="radio" name="filter" id=cat.id checked=cat.checked)
  .filters
    each cat in filterCategories
      label.filters__label(for=cat.id)= cat.label
  ul.works-grid
    each work, i in worksList
      li.works-grid__item(data-category=work.category)
        +work-card(work)
  +btn("Load more works", "#works", "outline").works__more

section.section.container
  +section-title("Clients & kind words", "Some of the teams that trusted us with their brands.")
  .clients
    each client in clientsList
      span.clients__logo(class=`clients__logo--${client.style}`)= client.name
  figure.quote
    span.quote__mark(aria-hidden="true") “
    blockquote.quote__text= testimonialData.quote
    figcaption.quote__footer
      .quote__author
        b.quote__avatar= testimonialData.initials
        span.quote__meta
          strong.quote__name= testimonialData.author
          small.quote__role= testimonialData.role
      .quote__dots(aria-hidden="true")
        - let d = 0;
        while d < testimonialData.dotsCount
          i.quote__dot(class={ "quote__dot--active": d === testimonialData.activeDot })
          - d++;

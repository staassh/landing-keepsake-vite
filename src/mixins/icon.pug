//- Inline SVG icon switcher using case / when
mixin icon(name, size = 16)
  case name
    when 'chevron'
      svg.nav__chev(viewBox='0 0 24 24' width=size height=size fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true')&attributes(attributes)
        path(d='M9 18l6-6-6-6')
    when 'heart'
      svg(viewBox='0 0 24 24' width=size height=size fill='currentColor' aria-hidden='true')&attributes(attributes)
        path(d='M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z')
    when 'mail'
      svg(viewBox='0 0 24 24' width=size height=size fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true')&attributes(attributes)
        path(d='M3 5h18v14H3zM3 6l9 7 9-7')
    when 'arrow-up'
      svg(viewBox='0 0 24 24' width=size height=size fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true')&attributes(attributes)
        path(d='M12 19V5M5 12l7-7 7 7')
    when 'service-web'
      svg(viewBox='0 0 48 48' width=size height=size aria-hidden='true')&attributes(attributes)
        rect(x='10' y='14' width='28' height='20' rx='2' fill='#89C4B8' stroke='#4D555E' stroke-width='2')
        rect(x='14' y='18' width='20' height='12' fill='#FFFFFF')
        line(x1='17' y1='22' x2='25' y2='22' stroke='#4D555E' stroke-width='2')
        line(x1='17' y1='26' x2='31' y2='26' stroke='#89C4B8' stroke-width='2')
    when 'service-motion'
      svg(viewBox='0 0 48 48' width=size height=size aria-hidden='true')&attributes(attributes)
        rect(x='11' y='14' width='26' height='20' rx='3' fill='#5D738A' stroke='#3A3A3C' stroke-width='2')
        rect(x='15' y='18' width='18' height='12' rx='1' fill='#A7C4DC')
    when 'service-print'
      svg(viewBox='0 0 48 48' width=size height=size aria-hidden='true')&attributes(attributes)
        rect(x='18' y='12' width='12' height='8' fill='#F2D06B')
        rect(x='12' y='19' width='24' height='11' rx='2' fill='#6D747E')
        rect(x='17' y='26' width='14' height='10' fill='#FFFFFF' stroke='#6D747E' stroke-width='1.5')
    when 'service-illustration'
      svg(viewBox='0 0 48 48' width=size height=size aria-hidden='true')&attributes(attributes)
        path(d='M24 35l-1.8-1.6C15.8 27.6 12 24.1 12 19.8 12 16.3 14.8 13.5 18.3 13.5c2 0 3.9.9 5.7 2.4 1.8-1.5 3.7-2.4 5.7-2.4 3.5 0 6.3 2.8 6.3 6.3 0 4.3-3.8 7.8-10.2 13.6L24 35z' fill='#F95858')
